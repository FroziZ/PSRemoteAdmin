<Project Sdk="WixToolset.Sdk/4.0.5">

  <PropertyGroup>
    <OutputType>Package</OutputType>
    <Platform>x64</Platform>
    <OutputName>PSRemoteAdmin-$(Version)-Setup</OutputName>
    <!-- Default version for local builds; overridden by CI via -p:Version=x.y.z -->
    <Version Condition="'$(Version)' == ''">1.0.0</Version>
    <!--
      Path to the published app output — no trailing backslash.
      Override with -p:AppPublishDir=... if needed.
      heat generates Source="$(var.PublishDir)\filename"; DefineConstants
      tells the WiX preprocessor what var.PublishDir resolves to so the
      linker can find the physical files.
    -->
    <AppPublishDir Condition="'$(AppPublishDir)' == ''">$(MSBuildThisFileDirectory)..\..\publish</AppPublishDir>
    <DefineConstants>Version=$(Version);PublishDir=$(AppPublishDir)</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="WixToolset.UI.wixext" Version="4.0.5" />
    <PackageReference Include="WixToolset.Heat" Version="4.0.5" />
  </ItemGroup>

  <!-- Harvest all published files into the install directory -->
  <ItemGroup>
    <HarvestDirectory Include="$(AppPublishDir)">
      <DirectoryRefId>INSTALLFOLDER</DirectoryRefId>
      <SuppressRootDirectory>true</SuppressRootDirectory>
      <ComponentGroupName>AppFiles</ComponentGroupName>
      <!--
        Tells heat to generate Source="$(var.PublishDir)\filename" instead
        of Source="SourceDir\filename". Combined with DefineConstants above,
        the WiX preprocessor substitutes the real path at compile time.
      -->
      <PreprocessorVariable>var.PublishDir</PreprocessorVariable>
    </HarvestDirectory>
  </ItemGroup>

</Project>
