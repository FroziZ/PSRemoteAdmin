<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs"
     xmlns:ui="http://wixtoolset.org/schemas/v4/wxs/ui">

  <!--
    UpgradeCode must NEVER change — it ties all future versions together for upgrade detection.
    If you fork this project, generate a new GUID here.
  -->
  <Package Name="PSRemoteAdmin"
           Manufacturer="FroziZ"
           Version="$(var.Version)"
           UpgradeCode="{8B3E1F2C-5A4D-4E6F-9C1B-2D7A8E9F0A3B}"
           Scope="perMachine">

    <!-- Automatically remove older versions on upgrade -->
    <MajorUpgrade DowngradeErrorMessage="A newer version of PSRemoteAdmin is already installed. Please uninstall it first." />

    <!-- Embed all files into the MSI (single-file installer) -->
    <MediaTemplate EmbedCab="yes" />

    <Feature Id="Main" Level="1">
      <ComponentGroupRef Id="AppFiles" />
      <ComponentRef Id="StartMenuShortcut" />
    </Feature>

    <!-- Simple install-dir dialog: lets user choose install path -->
    <ui:WixUI Id="WixUI_InstallDir" InstallDirectory="INSTALLFOLDER" />

  </Package>

  <!-- ===== Directory structure ===== -->
  <Fragment>
    <Directory Id="TARGETDIR" Name="SourceDir">
      <Directory Id="ProgramFiles64Folder">
        <Directory Id="INSTALLFOLDER" Name="PSRemoteAdmin" />
      </Directory>
      <Directory Id="ProgramMenuFolder">
        <Directory Id="ShortcutsDir" Name="PSRemoteAdmin" />
      </Directory>
    </Directory>
  </Fragment>

  <!-- ===== Start Menu shortcut ===== -->
  <Fragment>
    <Component Id="StartMenuShortcut"
               Directory="ShortcutsDir"
               Guid="{2C4F6A8D-1B3E-4D5F-8A9C-0E2F7B4C6D8E}">
      <Shortcut Id="AppShortcut"
                Name="PSRemoteAdmin"
                Description="PowerShell Remote Administration Tool"
                Target="[INSTALLFOLDER]PSRemoteAdmin.exe"
                WorkingDirectory="INSTALLFOLDER" />
      <!-- Required: remove the shortcut folder on uninstall -->
      <RemoveFolder Id="CleanupShortcutsDir" Directory="ShortcutsDir" On="uninstall" />
      <!-- Required: a registry key acts as the KeyPath so WiX can track this component -->
      <RegistryValue Root="HKCU"
                     Key="Software\PSRemoteAdmin"
                     Name="installed"
                     Type="integer"
                     Value="1"
                     KeyPath="yes" />
    </Component>
  </Fragment>

</Wix>
