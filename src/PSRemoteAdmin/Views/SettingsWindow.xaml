<Window x:Class="PSRemoteAdmin.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Settings — PSRemoteAdmin"
        Height="480" Width="520"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource BackgroundBrush}">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Title -->
        <TextBlock Grid.Row="0" Text="Settings" FontSize="18" FontWeight="SemiBold"
                   Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,20"/>

        <!-- Form -->
        <StackPanel Grid.Row="1">

            <!-- LDAP -->
            <StackPanel Margin="0,0,0,14">
                <Label Content="LDAP Connection String"/>
                <TextBox Text="{Binding LdapConnectionString, UpdateSourceTrigger=PropertyChanged}"
                         Margin="0,4,0,0"/>
                <TextBlock Text="e.g. LDAP://DC=corp,DC=local"
                           FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,3,0,0"/>
            </StackPanel>

            <!-- Domain -->
            <StackPanel Margin="0,0,0,14">
                <Label Content="Domain (NetBIOS or FQDN)"/>
                <TextBox Text="{Binding Domain, UpdateSourceTrigger=PropertyChanged}" Margin="0,4,0,0"/>
            </StackPanel>

            <!-- WinRM Port + Max Concurrency (side by side) -->
            <Grid Margin="0,0,0,14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <Label Content="WinRM Port"/>
                    <TextBox Text="{Binding WinRmPort, UpdateSourceTrigger=PropertyChanged}" Margin="0,4,0,0"/>
                </StackPanel>
                <StackPanel Grid.Column="2">
                    <Label Content="Max Concurrency"/>
                    <TextBox Text="{Binding MaxConcurrency, UpdateSourceTrigger=PropertyChanged}" Margin="0,4,0,0"/>
                </StackPanel>
            </Grid>

            <!-- RunAs Username -->
            <StackPanel Margin="0,0,0,14">
                <Label Content="Run As (username, optional)"/>
                <TextBox Text="{Binding RunAsUsername, UpdateSourceTrigger=PropertyChanged}" Margin="0,4,0,0"/>
            </StackPanel>

            <!-- RunAs Password -->
            <StackPanel Margin="0,0,0,14">
                <Label Content="Run As Password (stored in Windows Credential Locker)"/>
                <PasswordBox x:Name="PasswordBox" Margin="0,4,0,0"
                             PasswordChanged="PasswordBox_PasswordChanged"/>
                <TextBlock Text="Leave blank to keep existing password"
                           FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,3,0,0"/>
            </StackPanel>

            <!-- Test connection -->
            <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                <Button Content="Test Connection"
                        Command="{Binding TestConnectionCommand}"
                        IsEnabled="{Binding IsTesting, Converter={StaticResource InverseBoolConverter}}"/>
                <TextBlock Text="{Binding ConnectionTestMessage}"
                           VerticalAlignment="Center"
                           Margin="12,0,0,0"
                           Visibility="{Binding ConnectionTestMessage, Converter={StaticResource NullToVisibilityConverter}}">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding ConnectionTestSuccess}" Value="True">
                                    <Setter Property="Foreground" Value="{StaticResource StatusOnlineBrush}"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding ConnectionTestSuccess}" Value="False">
                                    <Setter Property="Foreground" Value="{StaticResource StatusOfflineBrush}"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </StackPanel>
        </StackPanel>

        <!-- Buttons -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right"
                    Margin="0,20,0,0">
            <Button Content="Cancel" Command="{Binding CancelCommand}"
                    CommandParameter="{Binding RelativeSource={RelativeSource AncestorType=Window}}"
                    Margin="0,0,10,0"/>
            <Button Content="Save" Style="{StaticResource AccentButtonStyle}"
                    Command="{Binding SaveCommand}"
                    CommandParameter="{Binding RelativeSource={RelativeSource AncestorType=Window}}"/>
        </StackPanel>
    </Grid>
</Window>
