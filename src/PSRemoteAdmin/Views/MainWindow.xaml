<Window x:Class="PSRemoteAdmin.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:PSRemoteAdmin.ViewModels"
        xmlns:core="clr-namespace:PSRemoteAdmin.Core.Models;assembly=PSRemoteAdmin.Core"
        xmlns:converters="clr-namespace:PSRemoteAdmin.Converters"
        Title="PSRemoteAdmin" Height="720" Width="1200"
        MinHeight="500" MinWidth="900"
        Background="{StaticResource BackgroundBrush}">

    <Window.Resources>
        <!-- Tree item template with tri-state checkbox -->
        <HierarchicalDataTemplate DataType="{x:Type vm:AdTreeNodeViewModel}"
                                  ItemsSource="{Binding Children}">
            <StackPanel Orientation="Horizontal" Margin="2">
                <CheckBox IsChecked="{Binding IsSelected}"
                          IsThreeState="True"
                          VerticalAlignment="Center"
                          Margin="0,0,4,0"/>
                <TextBlock VerticalAlignment="Center" Margin="0,0,4,0">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding NodeType}"
                                             Value="{x:Static core:AdNodeType.OrganizationalUnit}">
                                    <Setter Property="Text" Value="&#x1F4C1;"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding NodeType}"
                                             Value="{x:Static core:AdNodeType.Computer}">
                                    <Setter Property="Text" Value="&#x1F5A5;"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
                <TextBlock Text="{Binding Name}" VerticalAlignment="Center"/>
                <TextBlock Text=" ..." VerticalAlignment="Center"
                           Visibility="{Binding IsLoadingChildren, Converter={StaticResource BoolToVisibilityConverter}}"/>
            </StackPanel>
        </HierarchicalDataTemplate>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="180"/>
        </Grid.RowDefinitions>

        <!-- ===== Toolbar ===== -->
        <Border Grid.Row="0" Background="{StaticResource SurfaceBrush}"
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1">
            <DockPanel Margin="12,6">
                <TextBlock Text="PSRemoteAdmin" FontSize="15" FontWeight="SemiBold"
                           VerticalAlignment="Center" DockPanel.Dock="Left"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" DockPanel.Dock="Right">
                    <Button Content="Reload" Command="{Binding LoadTreeCommand}"
                            IsEnabled="{Binding IsLoadingTree, Converter={StaticResource InverseBoolConverter}}"
                            Margin="0,0,8,0"/>
                    <Button Content="Settings" Command="{Binding OpenSettingsCommand}"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- ===== Error Banner ===== -->
        <Border Grid.Row="1" Background="#7F1D1D"
                Padding="12,8"
                Visibility="{Binding ErrorBanner, Converter={StaticResource NullToVisibilityConverter}}">
            <TextBlock Text="{Binding ErrorBanner}" Foreground="#FCA5A5"/>
        </Border>

        <!-- ===== Three-Column Body ===== -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="260" MinWidth="160"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="200" MinWidth="140"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*" MinWidth="200"/>
            </Grid.ColumnDefinitions>

            <!-- === Left: AD Tree === -->
            <Border Grid.Column="0" Background="{StaticResource SurfaceBrush}"
                    BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,1,0">
                <DockPanel>
                    <Border DockPanel.Dock="Top" Background="{StaticResource SurfaceAltBrush}"
                            Padding="10,6" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1">
                        <TextBlock Text="Active Directory" FontWeight="SemiBold"/>
                    </Border>
                    <TreeView ItemsSource="{Binding AdTreeRoots}"
                              Background="Transparent" BorderThickness="0"
                              VirtualizingPanel.IsVirtualizing="True"
                              TreeViewItem.Expanded="TreeViewItem_Expanded">
                    </TreeView>
                </DockPanel>
            </Border>

            <GridSplitter Grid.Column="1" Width="4" HorizontalAlignment="Stretch"
                          Background="{StaticResource BorderBrush}" Cursor="SizeWE"/>

            <!-- === Center: Target Machines === -->
            <Border Grid.Column="2" Background="{StaticResource SurfaceBrush}"
                    BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,1,0">
                <DockPanel>
                    <Border DockPanel.Dock="Top" Background="{StaticResource SurfaceAltBrush}"
                            Padding="10,6" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1">
                        <TextBlock Text="Target Machines" FontWeight="SemiBold"/>
                    </Border>
                    <Border DockPanel.Dock="Bottom" Padding="10,6"
                            BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0">
                        <TextBlock Foreground="{StaticResource TextSecondaryBrush}" FontSize="11">
                            <Run Text="{Binding TargetMachines.Count, Mode=OneWay}"/>
                            <Run Text=" machine(s) selected"/>
                        </TextBlock>
                    </Border>
                    <ListBox ItemsSource="{Binding TargetMachines}"
                             Background="Transparent" BorderThickness="0"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" Margin="4,2">
                                    <TextBlock Text="{Binding StatusIcon}"
                                               Foreground="{Binding Status, Converter={StaticResource StatusToColorConverter}}"
                                               FontSize="10" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                    <TextBlock Text="{Binding Name}" VerticalAlignment="Center"/>
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>

            <GridSplitter Grid.Column="3" Width="4" HorizontalAlignment="Stretch"
                          Background="{StaticResource BorderBrush}" Cursor="SizeWE"/>

            <!-- === Right: Results === -->
            <Border Grid.Column="4" Background="{StaticResource SurfaceBrush}">
                <DockPanel>
                    <Border DockPanel.Dock="Top" Background="{StaticResource SurfaceAltBrush}"
                            Padding="10,6" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1">
                        <TextBlock Text="Results" FontWeight="SemiBold"/>
                    </Border>
                    <ItemsControl ItemsSource="{Binding ExecutionResults}"
                                  Background="Transparent">
                        <ItemsControl.Template>
                            <ControlTemplate>
                                <ScrollViewer VerticalScrollBarVisibility="Auto">
                                    <ItemsPresenter/>
                                </ScrollViewer>
                            </ControlTemplate>
                        </ItemsControl.Template>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Margin="0,0,0,1"
                                        Background="{StaticResource SurfaceAltBrush}"
                                        BorderBrush="{StaticResource BorderBrush}"
                                        BorderThickness="0,0,0,1">
                                    <StackPanel>
                                        <Grid Margin="10,8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="{Binding StatusIcon}"
                                                       FontSize="14" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                            <StackPanel Grid.Column="1">
                                                <TextBlock Text="{Binding MachineName}" FontWeight="SemiBold"/>
                                                <TextBlock Text="{Binding Summary}" FontSize="11"
                                                           Foreground="{StaticResource TextSecondaryBrush}"/>
                                            </StackPanel>
                                            <ToggleButton Grid.Column="2" Content="v"
                                                          IsChecked="{Binding IsExpanded}"
                                                          Background="Transparent" BorderThickness="0"
                                                          Foreground="{StaticResource TextSecondaryBrush}"
                                                          VerticalAlignment="Center"/>
                                        </Grid>
                                        <StackPanel Margin="10,0,10,10"
                                                    Visibility="{Binding IsExpanded, Converter={StaticResource BoolToVisibilityConverter}}">
                                            <TextBlock Text="stdout" FontSize="11"
                                                       Foreground="{StaticResource TextSecondaryBrush}"
                                                       Margin="0,0,0,2"/>
                                            <Border Background="{StaticResource BackgroundBrush}"
                                                    Padding="8" CornerRadius="3">
                                                <TextBox Text="{Binding Output, Mode=OneWay}"
                                                         IsReadOnly="True" BorderThickness="0"
                                                         Background="Transparent"
                                                         Foreground="{StaticResource TextPrimaryBrush}"
                                                         FontFamily="{StaticResource MonospaceFont}"
                                                         FontSize="11" TextWrapping="Wrap"
                                                         ScrollViewer.VerticalScrollBarVisibility="Auto"
                                                         MaxHeight="200"/>
                                            </Border>
                                            <TextBlock Text="stderr" FontSize="11"
                                                       Foreground="{StaticResource TextSecondaryBrush}"
                                                       Margin="0,6,0,2"
                                                       Visibility="{Binding ErrorOutput, Converter={StaticResource NullToVisibilityConverter}}"/>
                                            <Border Background="#1C0A0A" Padding="8" CornerRadius="3"
                                                    Visibility="{Binding ErrorOutput, Converter={StaticResource NullToVisibilityConverter}}">
                                                <TextBox Text="{Binding ErrorOutput, Mode=OneWay}"
                                                         IsReadOnly="True" BorderThickness="0"
                                                         Background="Transparent"
                                                         Foreground="{StaticResource StatusOfflineBrush}"
                                                         FontFamily="{StaticResource MonospaceFont}"
                                                         FontSize="11" TextWrapping="Wrap"
                                                         MaxHeight="100"/>
                                            </Border>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </DockPanel>
            </Border>
        </Grid>

        <!-- ===== Separator ===== -->
        <Separator Grid.Row="3" Background="{StaticResource BorderBrush}" Height="1"/>

        <!-- ===== Command Bar ===== -->
        <Grid Grid.Row="4" Background="{StaticResource SurfaceBrush}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Tab strip + file path -->
            <DockPanel Grid.Row="0" Margin="8,6,8,0">
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                    <RadioButton Content="Manual" GroupName="CommandMode" IsChecked="True"
                                 Foreground="{StaticResource TextPrimaryBrush}"
                                 Click="ManualMode_Click"
                                 Margin="0,0,8,0"/>
                    <RadioButton Content="File" GroupName="CommandMode"
                                 Foreground="{StaticResource TextPrimaryBrush}"
                                 Click="FileMode_Click"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" Margin="16,0,0,0"
                            DockPanel.Dock="Left">
                    <StackPanel.Style>
                        <Style TargetType="StackPanel">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding ActiveMode}"
                                             Value="{x:Static core:CommandMode.File}">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </StackPanel.Style>
                    <Button Content="Browse..." Command="{Binding BrowseFileCommand}" Padding="8,3"
                            Margin="0,0,8,0"/>
                    <TextBlock Text="{Binding LoadedFilePath}" FontSize="11"
                               Foreground="{StaticResource TextSecondaryBrush}"
                               VerticalAlignment="Center"
                               MaxWidth="300" TextTrimming="CharacterEllipsis"
                               Visibility="{Binding LoadedFilePath, Converter={StaticResource NullToVisibilityConverter}}"/>
                </StackPanel>
            </DockPanel>

            <!-- Editor -->
            <TextBox Grid.Row="1" Margin="8,4"
                     Text="{Binding CommandText, UpdateSourceTrigger=PropertyChanged}"
                     IsReadOnly="{Binding ActiveMode, Converter={StaticResource CommandModeToReadOnlyConverter}}"
                     AcceptsReturn="True"
                     AcceptsTab="True"
                     VerticalScrollBarVisibility="Auto"
                     FontFamily="{StaticResource MonospaceFont}"
                     FontSize="12"
                     Background="{StaticResource SurfaceAltBrush}"
                     Foreground="{StaticResource TextPrimaryBrush}"
                     BorderThickness="0"
                     Padding="8"/>

            <!-- Execute / Cancel row -->
            <DockPanel Grid.Row="2" Margin="8,4,8,8">
                <Button Content="Cancel"
                        DockPanel.Dock="Right" Margin="8,0,0,0"
                        Command="{Binding CancelExecutionCommand}"
                        Visibility="{Binding IsExecuting, Converter={StaticResource BoolToVisibilityConverter}}"/>
                <Button Content="{Binding ExecuteButtonLabel}"
                        DockPanel.Dock="Right"
                        Style="{StaticResource AccentButtonStyle}"
                        Command="{Binding ExecuteCommand}"
                        MinWidth="140"/>
                <TextBlock/>
            </DockPanel>
        </Grid>
    </Grid>
</Window>
